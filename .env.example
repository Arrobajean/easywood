# Copia este fichero como `.env` y completa los valores reales.
# El fichero `.env` esta ignorado por git: nunca comprometas valores reales.
# Sin estos valores, la build compila pero los formularios no envian datos.

# Firebase / Firestore (obligatorio para leads)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# EmailJS (formularios de contacto)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_USER_ID=

# Cloud Functions (solo si usas functions/): define estas variables
# en el entorno de la funcion, nunca en el repo.
# IONOS_USER=
# IONOS_PASS=
