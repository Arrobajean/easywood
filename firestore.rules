rules_version = '2';

// ============================================================================
// Reglas de seguridad de Firestore — EasyWood
//
//  - `callbacks`: el CallbackModal escribe
//    {name, phone, message, fecha, status, userAgent}. Solo create validado;
//    leer/actualizar/borrar solo admin (custom claim `admin: true`).
//  - `contactos`/`contacto_envios`: SIN escritura publica. El formulario de
//    contacto usa `contactFormHandler` (HTTPS, Admin SDK), que no pasa por
//    estas reglas.
//  - Resto: denegado por defecto.
//
// Desplegar con: firebase deploy --only firestore:rules --project <id>
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /callbacks/{id} {
      allow create: if request.resource.data.keys().hasOnly(
                      ['name', 'phone', 'message', 'fecha', 'status', 'userAgent']
                    )
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 2
                    && request.resource.data.name.size() <= 120
                    && request.resource.data.phone is string
                    && request.resource.data.phone.matches('^[0-9\\s\\-\\+]{7,30}$')
                    && (!('message' in request.resource.data)
                        || (request.resource.data.message is string
                            && request.resource.data.message.size() <= 2000))
                    && request.resource.data.fecha is timestamp
                    && request.resource.data.status == 'nuevo'
                    && (!('userAgent' in request.resource.data)
                        || (request.resource.data.userAgent is string
                            && request.resource.data.userAgent.size() <= 1000));
      allow read, update, delete: if isAdmin();
    }

    match /contactos/{id} {
      allow read, write: if isAdmin();
    }

    match /contacto_envios/{id} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
